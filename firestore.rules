rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Audits are written exclusively by the analyze Function via the Admin SDK
    // (which bypasses these rules). Clients may only read and delete their own.
    match /users/{uid}/audits/{auditId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }
    // Trackers are user preference data (label, codes, limit, plan-year start).
    // Owner-managed entirely client-side; no integrity concerns.
    match /users/{uid}/trackers/{trackerId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
    // Saved EOBs hold ONLY the redacted text (originals never leave the
    // device), for reuse against future bills. Owner-managed like trackers.
    match /users/{uid}/eobs/{eobId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
    // The active plan (SBC) is written exclusively by the extractPlan Function
    // via the Admin SDK. Clients may only read and delete their own.
    match /users/{uid}/plan/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }
    // Rate-limit counters are Function-managed; clients never touch them.
    match /users/{uid}/meta/{docId} {
      allow read, write: if false;
    }
    // In-app feedback is written exclusively by the submitFeedback Function;
    // read in the console. No client access at all.
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
