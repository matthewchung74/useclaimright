node_modules/
.DS_Store
.firebase/
*.log
.env
functions/.env*
.gstack/
functions/.secret.local
measure-ocr.mjs
measure-scan.mjs
measure-live.mjs

# Generated by graphify — rebuildable, not source
graphify-out/
measure-sbc.mjs
test/browser/node_modules/

# Derived from the canonical fixtures — rebuild with:
#   node test-fixtures/gen-by-plan.mjs
test-fixtures/by-plan/

# Real carrier documents — insurer copyright, not ours to redistribute, and the
# repo is public. Rebuild with:
#   test-fixtures/carrier/fetch.sh
test-fixtures/carrier/*.pdf

# Documents a member supplied: their own plan booklet, their own EOB. No script
# can rebuild these — there is no public URL — so unlike carrier/ they are gone
# for anyone who does not have them, and every test that uses them skips.
# NOTHING in here is ever committed, including notes about what is in them.
test-fixtures/private/*
!test-fixtures/private/README.md

# video/: lines.json and the .py/.mjs files are the source; everything a render
# produces is a build artefact. Rebuild a Short with the three commands in
# video/README.md.
video/**/*.mp4
video/**/*.mov
video/**/*.png
video/**/*.wav
video/**/audio/
video/*/frames/
video/node_modules/
__pycache__/
